# Host público (vai para o KC_HOSTNAME e para o Ingress)
KC_HOSTNAME=keycloak.actionstat.app
KC_LOG_LEVEL=info
# Host público do assistente (vai para o HOST dele e para o Ingress)
ASSISTENTE_HOSTNAME=keycloak-assistente.actionstat.app

# Banco: StatefulSet keycloak-db (k8s/postgres.yaml)
KC_DB_URL=jdbc:postgresql://keycloak-db:5432/keycloak

# Placeholders do realm/automateflow-realm.json (só valem na primeira importação)
KC_REALM=automateflow
KC_REALM_ADMIN_USER=admin
ATLAS_INSIGHTS_URL=https://atlas-insights.actionstat.app
LINODE_INSIGHTS_URL=https://linode-insights.actionstat.app
MONGO_MIGRATOR_URL=https://mongo-migrator.actionstat.app
