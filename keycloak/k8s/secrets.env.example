# Copie para k8s/secrets.env (está no .gitignore) e troque as senhas.
# Admin do console (realm master). Só vale no primeiro boot, com o banco vazio.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=troque-esta-senha
# Usuário/senha do Postgres. Só valem quando o volume ainda está vazio.
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=troque-esta-senha
# Senha do KC_REALM_ADMIN_USER (role ADMIN) do realm importado
KC_REALM_ADMIN_PASSWORD=troque-esta-senha
