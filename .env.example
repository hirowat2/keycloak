# --- Keycloak ---
# Host público atrás do Traefik
KC_HOST=keycloak.docker.localhost
# Admin do console (realm master). Só vale no primeiro boot, com o banco vazio.
# O assistente usa este mesmo usuário na Admin API.
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=troque-esta-senha
KC_LOG_LEVEL=info

# --- Banco (Postgres do próprio Keycloak) ---
KC_DB_NAME=keycloak
KC_DB_USER=keycloak
KC_DB_PASSWORD=troque-esta-senha

# --- Realm importado de realm/automateflow-realm.json ---
# Só é aplicado quando o realm ainda não existe. Para reimportar: make reset
KC_REALM=automateflow
# Usuário do realm com a role ADMIN (vira superuser nos apps e Admin no assistente)
KC_REALM_ADMIN_USER=admin
KC_REALM_ADMIN_PASSWORD=troque-esta-senha
# URLs públicas dos apps (redirect URIs dos clients)
ATLAS_INSIGHTS_URL=https://atlas-insights.docker.localhost
LINODE_INSIGHTS_URL=https://linode-insights.docker.localhost
MONGO_MIGRATOR_URL=https://mongo-migrator.docker.localhost

# --- Assistente (app Django) ---
ASSISTENTE_HOST=keycloak-assistente.docker.localhost
ASSISTENTE_DB_PASSWORD=troque-esta-senha
# SECRET_KEY é criada pelo make secret
